# =============================================================================
# Production env reference for compose.prod.yaml.
#
# Used in two ways:
#   1. As the source of truth for what to set as Woodpecker secrets/variables
#      (see .woodpecker/deploy.yaml — secrets are referenced from_secret).
#   2. As a starting point for local prod-like testing:
#         cp env.production.example .env
#         docker compose -f compose.prod.yaml up -d --build postgres
#         docker compose -f compose.prod.yaml run --rm migrate
#         docker compose -f compose.prod.yaml up -d --wait backend frontend
#         docker compose -f compose.prod.yaml up -d bot
#
# Generate the two long secrets with: openssl rand -base64 32
# =============================================================================

# -----------------------------------------------------------------------------
# Required for a full backend + frontend + bot deploy
# -----------------------------------------------------------------------------
POSTGRES_PASSWORD=replace-with-a-strong-database-password
# Set this only when running compose/stack manually with a password containing
# URL-reserved characters such as @, :, /, ?, #, %, or &. Woodpecker computes it.
POSTGRES_PASSWORD_URLENCODED=
BETTER_AUTH_SECRET=replace-with-a-long-random-auth-secret
BOT_API_KEY=replace-with-a-shared-backend-bot-key

# Public hostnames (must be reachable through the host's reverse proxy).
# FRONTEND_URL is where users land. The backend public origin is used by
# Better Auth, upload URLs, and frontend-server auth forwarding. It is not
# exposed as a Vite/browser API base URL.
FRONTEND_URL=https://constancia.rpgtools.eu.org
BETTER_AUTH_URL=https://constancia.rpgtools.eu.org
BACKEND_PUBLIC_URL=https://constancia.rpgtools.eu.org

# Optional override when Better Auth cookies must be shared across sibling
# subdomains. If left empty, the backend derives the shared parent domain from
# FRONTEND_URL and BETTER_AUTH_URL when possible.
AUTH_COOKIE_DOMAIN=

DISCORD_TOKEN=replace-with-your-discord-bot-token
DISCORD_CLIENT_ID=replace-with-your-discord-application-client-id

# -----------------------------------------------------------------------------
# Host-side ports Caddy proxies into.
# Keep these aligned with the constancia.rpgtools.eu.org Caddyfile block.
# -----------------------------------------------------------------------------
FRONTEND_PORT=3020
BACKEND_PORT=3021
BOT_HTTP_PORT=3002

# -----------------------------------------------------------------------------
# Safe defaults — keep as-is unless you have a reason to change them
# -----------------------------------------------------------------------------
POSTGRES_DB=constancia
POSTGRES_USER=constancia
MAGIC_LINK_FRONTEND_PATH=/auth
VITE_DISCORD_AUTH_ENABLED=false
CONTENT_MODERATION_ENABLED=false
CONTENT_MODERATION_MODEL=omni-moderation-latest
CONTENT_MODERATION_FAIL_CLOSED=true
UPLOAD_STORAGE_DRIVER=local
UPLOAD_MAX_BYTES=5242880
UPLOAD_IMAGE_MAX_DIMENSION=1024
UPLOAD_WEBP_QUALITY=80
UPLOAD_DEFAULT_ENABLED=false
UPLOAD_DEFAULT_ALLOWANCE_BYTES=52428800
UPLOAD_QUOTA_WARNING_PERCENT=80

# -----------------------------------------------------------------------------
# Optional Discord OAuth for direct frontend sign-in.
# Leave empty unless you want Better Auth social login enabled.
# Redirect URL to register in the Discord developer portal:
#   ${BETTER_AUTH_URL}/auth/callback/discord
# -----------------------------------------------------------------------------
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=

# -----------------------------------------------------------------------------
# Optional content moderation (required only when CONTENT_MODERATION_ENABLED=true)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# Optional public URL prefix for directly public upload storage.
#
# Leave empty for the default production path: uploads are stored in R2, but
# public URLs use BACKEND_PUBLIC_URL/api/v1/uploads/:assetId and the backend
# streams the object from R2. In that mode, Caddy must route /api/v1/uploads/*
# to the backend.
#
# Set only if the R2 bucket itself is public, for example through a Cloudflare
# custom domain or r2.dev development URL. The app will append uploads/:key.
# -----------------------------------------------------------------------------
UPLOAD_PUBLIC_BASE_URL=

# -----------------------------------------------------------------------------
# Optional Cloudflare R2 storage (required only when UPLOAD_STORAGE_DRIVER=r2)
# -----------------------------------------------------------------------------
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
