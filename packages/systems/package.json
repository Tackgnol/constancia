{
  "name": "@constancia/systems",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest watch"
  },
  "dependencies": {
    "@constancia/block-catalogue": "*",
    "@constancia/contracts": "*"
  },
  "devDependencies": {
    "vitest": "^3.2.4"
  }
