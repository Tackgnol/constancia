{
  "name": "@constancia/api-client",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./endpoints/*": {
      "import": {
        "types": "./dist/generated/endpoints/*.d.ts",
        "default": "./dist/generated/endpoints/*.js"
      },
      "types": "./dist/generated/endpoints/*.d.ts",
      "default": "./dist/generated/endpoints/*.js"
    },
    "./model": {
      "import": {
        "types": "./dist/generated/model/index.d.ts",
        "default": "./dist/generated/model/index.js"
      },
      "types": "./dist/generated/model/index.d.ts",
      "default": "./dist/generated/model/index.js"
    }
  },
  "scripts": {
    "build": "npm run generate && tsc",
    "generate": "cd ../.. && npm run generate:api",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/"
  }
}
