{
  "name": "@constancia/bot",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm --workspace @constancia/api-client run build",
    "dev": "tsx watch src/main.ts",
    "prebuild": "npm --workspace @constancia/api-client run build",
    "build": "tsc",
    "start": "node dist/main.js",
    "generate:api": "cd ../.. && npm run generate:api",
    "pretypecheck": "npm --workspace @constancia/api-client run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "pretest": "npm --workspace @constancia/api-client run build",
    "test": "vitest run",
    "test:watch": "vitest watch"
  },
  "dependencies": {
    "@constancia/api-client": "*",
    "@constancia/contracts": "*",
    "discord.js": "^14.0.0",
    "fastify": "^5.3.3"
  },
  "devDependencies": {
    "tsx": "^4.0.0",
    "vitest": "^3.2.4"
  }
}
